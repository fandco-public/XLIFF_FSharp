#!fsharp

let schemaString = """
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="root">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="element1" minOccurs="1" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="attr1" type="xs:string" use="required"/>
                        <xs:attribute name="attr2" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="element2" minOccurs="1" maxOccurs="1">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="child1" minOccurs="1" maxOccurs="1" type="xs:string"/>
                            <xs:element name="child2" minOccurs="1" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="attr4" type="xs:string" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                        <xs:attribute name="attr3" type="xs:string" use="required"/>
                    </xs:complexType>
                </xs:element>
                <xs:element name="element3" minOccurs="1" maxOccurs="1" type="xs:string"/>
                <xs:element name="element4" minOccurs="1" maxOccurs="1">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="child3" minOccurs="1" maxOccurs="1" type="xs:string"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>
"""

#!fsharp

let XmlSchemaSet = System.Xml.Schema.XmlSchemaSet()
let stringReader = new System.IO.StringReader(schemaString)
XmlSchemaSet.Add(null, XmlReader.Create(stringReader)) |> ignore
let xmlSettingsWithInlineSchema = { defaultXMLReaderSettings with Schemas = XmlSchemaSet; 
                                                                  ValidationType = ValidationType.Schema }

let nodesWithInlineSchema = readXml xmlStringWithInlineSchema xmlSettingsWithInlineSchema
Console.WriteLine("\nNode count: {0}", nodesWithInlineSchema.Length)
for node in nodesWithInlineSchema do
    Console.WriteLine(node)
