#!fsharp

open System
open System.Xml
open System.Xml.Schema


// Define the XmlReaderSettings with schema validation
let xmlSettingsWithInlineSchema = XmlReaderSettings()
xmlSettingsWithInlineSchema.ValidationType <- ValidationType.Schema
xmlSettingsWithInlineSchema.XmlResolver <- XmlUrlResolver() // Enable retrieval of external resources

// Define a validation event handler to handle validation errors
let validationEventHandler = ValidationEventHandler(fun sender args ->
    match args.Severity with
    | XmlSeverityType.Warning -> printfn "Warning: %s" args.Message
    | XmlSeverityType.Error -> printfn "Error: %s" args.Message
    | _ -> failwith "Unknown validation error"
)
xmlSettingsWithInlineSchema.ValidationEventHandler <- validationEventHandler

// Read and validate the XML
let stringReader = new System.IO.StringReader(xmlStringWithInlineSchema)
use reader = XmlReader.Create(stringReader, xmlSettingsWithInlineSchema)
while reader.Read() do
    // Process the XML document
    ()

// Example usage
let nodesWithInlineSchema = readXml xmlStringWithInlineSchema xmlSettingsWithInlineSchema
Console.WriteLine("\nNode count: {0}", nodesWithInlineSchema.Length)
for node in nodesWithInlineSchema do
    Console.WriteLine(node)

